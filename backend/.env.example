MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=video_journal_db

APP_NAME=Video Journal Tracker
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000
AUTH_REQUIRED=false
# Required when AUTH_REQUIRED=true. Find this in your Supabase project settings.
# SUPABASE_JWT_SECRET=

MEDIA_STORAGE_ROOT=backend/video_service/storage
TEMP_UPLOAD_ROOT=backend/video_service/temp
MAX_UPLOAD_BYTES=262144000
ALLOWED_MEDIA_EXTENSIONS=.aac,.avi,.flac,.m4a,.m4v,.mkv,.mov,.mp3,.mp4,.ogg,.wav,.webm

# Local faster-whisper transcription settings.
# Good starter options: tiny, base, small, medium.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional: set a language hint like "en" for faster/more stable transcription.
# WHISPER_LANGUAGE=en

# Local Ollama summary settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SUMMARY_MODEL=llama3.2:3b
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
